{
  "name": "lunar-site-planner",
  "private": true,
  "version": "0.1.0",
  "description": "Compare lunar landing sites and dates: Sun and Earth over the real horizon, solar power and direct-to-Earth link windows. CesiumJS + LOLA terrain.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build -c vite.api.config.js && node tools/build_api.mjs dist/api/v1 && node tools/fix-cesium-path.mjs",
    "preview": "vite preview",
    "test": "node --test test/*.spec.js",
    "test:smoke": "node test/smoke-e2e.cjs http://localhost:4174/",
    "test:e2e": "node test/browser-e2e.cjs http://localhost:5174/planner.html",
    "tutorial:shots": "node tools/tutorial/capture-shots.cjs http://localhost:4174/planner.html",
    "tutorial:video": "node tools/tutorial/render-video.cjs http://localhost:4174/planner.html",
    "api:maps": "python3 tools/export_geotiff.py"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "astronomy-engine": "^2.1.19",
    "cesium": "1.138.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.7.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.8",
    "vite-plugin-cesium": "^1.2.23"
  },
  "overrides": {
    "@cesium/widgets": "14.3.0",
    "@cesium/engine": "22.3.0"
  }
}
