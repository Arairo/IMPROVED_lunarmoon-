# Cloudflare Pages / Netlify style _headers, for if the site moves off GitHub Pages
# (which cannot set response headers). Copy to public/_headers so Vite puts it in dist/.
# Both policies were tested enforced against the production build with no violations
# (docs/HOSTING.md). Roll out as Content-Security-Policy-Report-Only first.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.cesium.com; font-src 'self' data:; connect-src 'self' data: blob: https://api.cesium.com https://assets.ion.cesium.com https://assets.cesium.com; worker-src 'self' blob:; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/planner.html
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.cesium.com; font-src 'self' data:; connect-src 'self' data: blob: https://api.cesium.com https://assets.ion.cesium.com https://assets.cesium.com; worker-src 'self' blob:; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Vite fingerprints everything in /assets/, so those never change under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Pages and data keep their names between releases: always revalidate.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/planner.html
  Cache-Control: no-cache
/data/*
  Cache-Control: public, max-age=0, must-revalidate
